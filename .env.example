# Copy to .env (git-ignored) for docker compose. Empty values fall back to the local-demo defaults.

# Production: the API refuses to start unless JWT_SIGNING_KEY and ADMIN_PASSWORD_HASH are set.
ASPNETCORE_ENVIRONMENT=Production
FRONTEND_BASE_URL=http://localhost:8080

# At least 32 random characters, e.g.:  openssl rand -base64 48
JWT_SIGNING_KEY=
# From:  cd backend/SupportTickets.Api && dotnet run -- hash-password   (then type the password)
ADMIN_PASSWORD_HASH=

# AI summary: None | Gemini | OpenAI
AI_PROVIDER=None
GEMINI_API_KEY=
OPENAI_API_KEY=

# Email: Console | Smtp   (Gmail: an App Password, not the account password)
EMAIL_PROVIDER=Console
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
