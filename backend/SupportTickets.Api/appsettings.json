{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "FrontendBaseUrl": "http://localhost:5201"
  },
  "Storage": {
    "DataDirectory": "App_Data",
    "SeedFile": "../../dataset.json"
  },
  "Ai": {
    "Provider": "None"
  },
  "Email": {
    "Provider": "Console"
  },
  "Jwt": {
    "Issuer": "SmartSupportTickets",
    "Audience": "SmartSupportTickets",
    "LifetimeMinutes": 60
  },
  "Auth": {
    "Admin": {
      "Username": "admin"
    },
    "LoginRateLimit": {
      "PermitLimit": 5,
      "GlobalPermitLimit": 30
    }
  }
}
